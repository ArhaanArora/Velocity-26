{
  "name": "cyberlab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/start.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "node server/start.mjs --preview",
    "test": "node src/lib/runChecks.mjs",
    "ai": "node --env-file-if-exists=.env server/chat.mjs",
    "test:ai": "node --test server/chat.test.mjs",
    "dev:frontend": "vite --host 127.0.0.1",
    "preview:frontend": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
